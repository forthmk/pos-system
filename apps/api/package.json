{
    "name": "@pos-system/api",
    "version": "1.0.0",
    "description": "POS System API",
    "main": "dist/index.js",
    "scripts": {
        "test": "node --import tsx --test \"src/test/**/*.test.ts\"",
        "dev": "tsx watch src/index.ts | pino-pretty",
        "start": "node dist/index.js | pino-pretty",
        "build": "tsc",
        "server": "node dist/index.js",
        "db:gen": "kysely-codegen --out-file ./src/config/database/types.gen.ts --no-camel-case",
        "db:migrate": "tsx src/migrations/migrate.ts",
        "db:rollback": "tsx src/migrations/migrate-down.ts",
        "db:seed": "tsx scripts/seed.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.816.0",
        "@aws-sdk/s3-request-presigner": "^3.1019.0",
        "@pos-system/shared": "workspace:*",
        "@fastify/compress": "^7.0.3",
        "@fastify/cors": "^9.0.1",
        "@fastify/jwt": "^7.2.0",
        "@fastify/multipart": "^8.3.0",
        "@fastify/mysql": "^4.3.0",
        "@fastify/sensible": "^5.6.0",
        "@fastify/static": "^7.0.4",
        "@sinclair/typebox": "^0.34.49",
        "@types/node": "^20.14.10",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.4.5",
        "fastify": "^4.28.1",
        "fastify-bcrypt": "^1.0.1",
        "fastify-plugin": "^4.5.1",
        "kysely": "^0.29.2",
        "mysql2": "^3.13.0",
        "p-limit": "^5.0.0",
        "pino-pretty": "^11.0.0",
        "sharp": "^0.33.5",
        "slugify": "^1.6.6",
        "tsx": "^4.22.3",
        "uuid": "^11.0.3",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "kysely-codegen": "^0.20.0",
        "typescript": "^6.0.3"
    }
}
